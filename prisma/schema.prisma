// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DemoRequest {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  interests String?
  createdAt DateTime @default(now())
}
